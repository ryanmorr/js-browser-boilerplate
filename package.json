{
  "name": "js-browser-boilerplate",
  "description": "Minimal boilerplate for browser-based JavaScript projects",
  "version": "0.1.0",
  "license": "Unlicense",
  "author": "Ryan Morr",
  "homepage": "https://github.com/ryanmorr/js-browser-boilerplate",
  "bugs": "https://github.com/ryanmorr/js-browser-boilerplate/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ryanmorr/js-browser-boilerplate.git"
  },
  "keywords": [],
  "type": "module",
  "main": "dist/cjs/<insert-name>.js",
  "module": "dist/esm/<insert-name>.js",
  "browser": "dist/umd/<insert-name>.js",
  "exports": {
    ".": {
      "browser": "./dist/umd/<insert-name>.js",
      "import": "./dist/esm/<insert-name>.js",
      "require": "./dist/cjs/<insert-name>.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "lint": "eslint src/** test/specs/**",
    "test": "karma start karma.config.cjs",
    "build": "rollup -c"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^24.0.1",
    "@rollup/plugin-node-resolve": "^15.0.1",
    "@rollup/plugin-terser": "^1.0.0",
    "chai": "^4.3.7",
    "eslint": "^8.33.0",
    "karma": "^4.0.0",
    "karma-chai": "^0.1.0",
    "karma-chrome-launcher": "^3.1.1",
    "karma-mocha": "^2.0.1",
    "karma-mocha-reporter": "^2.2.5",
    "karma-rollup-preprocessor": "^5.0.2",
    "karma-sinon": "^1.0.5",
    "mocha": "^12.0.3",
    "rollup": "^3.14.0",
    "rollup-plugin-generate-package-json": "^3.2.0",
    "sinon": "^15.0.1",
    "terser": "^5.16.3"
  }
}
